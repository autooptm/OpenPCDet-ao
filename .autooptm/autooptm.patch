+        mask = (pts[:, 0] >= rng[0]) & (pts[:, 0] <= rng[3]) & (pts[:, 1] >= rng[1]) & (pts[:, 1] <= rng[4])
+        pts = pts[mask]
+        coor = torch.floor((pts[:, :3] - rng[:3]) / plan['voxel_size'])
+        valid_idx = ((coor >= 0) & (coor < plan['grid_t'])).all(dim=1).nonzero().squeeze(1)
